# Get a free API key at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_football_data_org_key

# Historical training data CSVs (upcoming fixtures come from the API)
EPL_HISTORY_CSV=../data/epl-final.csv
UCL_CSV=../data/champions-league-*.csv

# CORS origin for your frontend (Vercel URL or localhost)
FRONTEND_URL=http://localhost:3000

# ── Optional ─────────────────────────────────────────────────────────────
# Shared model, match days and tickets (Upstash Redis, rediss://...)
# UPSTASH_REDIS_URL=
# Bookmaker odds (the-odds-api.com)
# ODDS_API_KEY=
# Referee appointments (dashboard.api-football.com)
# APIFOOTBALL_KEY=
# Clerk sign-in: Frontend API URL and secret key (Clerk Dashboard → API keys)
# CLERK_ISSUER=
# CLERK_SECRET_KEY=
# Clerk user ids allowed into the admin page, comma-separated
# ADMIN_USER_IDS=
# Premium payments
# PAYSTACK_SECRET_KEY=
# AI chat and match analysis
# GROQ_API_KEY=
