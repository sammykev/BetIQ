# Caddy gets and renews the HTTPS certificate for $DOMAIN by itself.
{$DOMAIN} {
	encode gzip
	reverse_proxy api:8000
}

# NGX Quant API (separate repo, same server): ngx.<DOMAIN>, e.g.
# ngx.203-0-113-5.sslip.io. Proxies over the shared "web" network.
ngx.{$DOMAIN} {
	encode gzip
	reverse_proxy ngx-api:8001
}
