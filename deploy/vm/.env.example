# Copy to .env (setup.sh does this) and fill in. Copy the values from
# Render: dashboard → your backend service → Environment.

# Web address of this server. setup.sh fills in <your-ip>.sslip.io, which
# needs no signup. A DuckDNS name (e.g. betiq-api.duckdns.org) works too.
DOMAIN=

# ── Required ──
FOOTBALL_DATA_API_KEY=
FRONTEND_URL=https://predict-withbetiq.vercel.app
# This server's Redis (docker-compose.yml): REDIS_PASSWORD from
# openssl rand -hex 24, and the URL with that same password:
#   UPSTASH_REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
# (the name is from when it was on Upstash)
REDIS_PASSWORD=
UPSTASH_REDIS_URL=
# Long and random: openssl rand -hex 24 (the same value on Vercel)
ADMIN_SECRET=
# Page-view reporting from the site; the same value on Vercel (optional)
TRAFFIC_KEY=
# Clerk user ids allowed into the admin page (comma-separated)
ADMIN_USER_IDS=

# ── Sign-in (Clerk) ──
CLERK_ISSUER=https://sweet-egret-17.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=
# Clerk dashboard → API keys → Secret key: lets the server check who is Premium
CLERK_SECRET_KEY=

# ── Odds, AI and payments ──
ODDS_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
PAYSTACK_SECRET_KEY=

# ── Push notifications ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=

# ── Results backup ──
# API-Football (dashboard.api-football.com, free plan): scores for matches
# ESPN lists but never scores (small friendlies). Same key as GitHub's secret.
APIFOOTBALL_KEY=

# ── Other sports ──
BETSAPI_TOKEN=

# ── Predictions ──
# How many days ahead to fetch and predict (default 14)
PREDICTION_DAYS=14

# ── SportyBet booking ──
SPORTYBET_COUNTRY=ng
SPORTYBET_PROXY=

# Post the daily odds on X (admin → Messaging → Daily odds on X). From an X
# developer app with "Read and write" permission; make the access token and
# secret after setting that permission.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Post the daily odds to a Telegram channel (admin → Messaging → Daily odds on
# Telegram): a bot from @BotFather, added to the channel as an administrator.
# TELEGRAM_CHAT_ID is @yourchannel (public) or the channel's -100… id (private).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Admin alerts (league drift check): your own chat id with the bot (message
# @userinfobot for it), or a private group's -100… id. Never the public channel.
TELEGRAM_ADMIN_CHAT_ID=

# Off-server copy of the nightly Redis backup (backup-redis.sh). Leave
# BACKUP_REMOTE empty to keep backups on this server only. With Backblaze B2:
# make a bucket and an application key for it, then
#   BACKUP_REMOTE=b2:your-bucket/betiq
#   RCLONE_CONFIG_B2_TYPE=b2
#   RCLONE_CONFIG_B2_ACCOUNT=<keyID>
#   RCLONE_CONFIG_B2_KEY=<applicationKey>
# Any rclone remote works (RCLONE_CONFIG_<NAME>_...). Backups are encrypted
# with BACKUP_PASSPHRASE before upload: keep a copy of it somewhere else too,
# a backup can't be opened without it (openssl rand -hex 32 makes one).
BACKUP_REMOTE=
BACKUP_PASSPHRASE=
BACKUP_REMOTE_DAYS=60
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=
RCLONE_CONFIG_B2_KEY=
